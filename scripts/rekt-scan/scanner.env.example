# Copy to .env.scanner in the repository root (ignored by Git).
# One Alchemy app key with Base Mainnet and Robinhood Mainnet enabled.
REKT_ALCHEMY_API_KEY=

# Optional: separate chain-specific RPC endpoints instead of the key above.
# With Alchemy endpoints the scanner can also use them for indexed history.
# REKT_BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
# REKT_ROBINHOOD_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY

# Optional: separate Alchemy-compatible indexed-history endpoints.
# REKT_BASE_INDEXER_URL=
# REKT_ROBINHOOD_INDEXER_URL=

# Optional Relay v3 credentials. Without this the existing v2 path is used.
# REKT_RELAY_API_KEY=

# Per-scan RPC load limits. CLI flags override these values.
# Includes all RPC hosts/chains and retries; other processes are not coordinated.
REKT_CU_PER_SECOND=450
REKT_MAX_CU=50000
