{
  "name": "vibecemetery",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "playwright test -c playwright.unit.config.ts",
    "test:v2-runtime": "playwright test -c playwright.v2-runtime.config.ts",
    "cutover": "node --experimental-strip-types scripts/v2-cutover/cli.mts",
    "rekt:scan": "node --experimental-strip-types scripts/rekt-scan/cli.mts",
    "rekt:discover": "node --experimental-strip-types scripts/rekt-scan/cli.mts --source auto",
    "rekt:fast": "node --experimental-strip-types scripts/rekt-scan/cli.mts --source auto --history-provider alchemy --concurrency 10 --request-interval-ms 25 --deadline-ms 28000 --pool-history defer --cache-dir .local-archive/rekt/cache",
    "rekt:funding": "node --experimental-strip-types scripts/rekt-scan/funding.mts",
    "test:rekt": "node --experimental-strip-types --test scripts/rekt-scan/*.test.mts",
    "check:v2-bundle": "node scripts/check-v2-bundle.mjs",
    "test:e2e": "playwright test -c playwright.config.ts",
    "test:web3-e2e": "playwright test -c playwright.web3.config.ts",
    "test:bury-skill": "playwright test -c tests/bury-skill-config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "~2.109.0",
    "@tanstack/react-query": "^5.101.4",
    "next": "^16.2.10",
    "next-auth": "^4.24.13",
    "phaser": "^3.90.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "viem": "^2.55.10",
    "wagmi": "^3.7.5"
  },
  "overrides": {
    "uuid": "11.1.1",
    "postcss": "8.5.26"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
