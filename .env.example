# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=
SUPABASE_SERVICE_KEY=

# GitHub OAuth (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub PAT for repo scanning (https://github.com/settings/tokens — no special permissions needed)
GITHUB_TOKEN=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
CLI_TOKEN_SECRET=

# Agent Ash auth and ingest (server-side only)
# AGENT_ASH_TOKEN_SECRET derives browser-approved ash_ tokens.
# Use a dedicated long random server-side secret in production.
# Do not add AGENT_ASH_INGEST_TOKEN; ingest must use DB-backed ash_ tokens.
AGENT_ASH_TOKEN_SECRET=
GITLAWB_ALLOWED_NODE_URLS=https://node.gitlawb.com

# Optional shared rate limiting for production (recommended)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional non-Vercel proxy support. Set only if your proxy strips spoofed forwarding headers.
TRUST_PROXY_HEADERS=
