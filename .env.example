# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=
SUPABASE_SERVICE_KEY=

# GitHub OAuth (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub PAT for repo scanning (https://github.com/settings/tokens — no special permissions needed)
GITHUB_TOKEN=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
CLI_TOKEN_SECRET=

# Agent Ash ingest (server-side only)
AGENT_ASH_INGEST_TOKEN=ash_generate_32_plus_random_chars
GITLAWB_ALLOWED_NODE_URLS=https://node.gitlawb.com

# Optional shared rate limiting for production (recommended)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
