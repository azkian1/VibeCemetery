# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=
SUPABASE_SERVICE_KEY=

# GitHub OAuth (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub PAT for repo scanning (https://github.com/settings/tokens — no special permissions needed)
GITHUB_TOKEN=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
CLI_TOKEN_SECRET=

# Paused Agent Layer / Agent Ash legacy variables.
# Not required for the main cemetery, GitHub scan, cremation, or /bury flows.
# If reviving Agent Ash, audit docs/agent-layer-archive/ before setting these.
# AGENT_ASH_TOKEN_SECRET=
# GITLAWB_ALLOWED_NODE_URLS=https://node.gitlawb.com

# Optional shared rate limiting for production (recommended)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional non-Vercel proxy support. Set only if your proxy strips spoofed forwarding headers.
TRUST_PROXY_HEADERS=

# Web3 grave offerings (keep both flags off until the release checklist passes)
WEB3_GRAVE_BURNS_ENABLED=false
NEXT_PUBLIC_WEB3_GRAVE_BURNS_ENABLED=false
BASE_RPC_URL=
GRAVE_BURN_REVERIFY_SECRET=
# Vercel Cron sends CRON_SECRET as its bearer token. Set it to the same value
# as GRAVE_BURN_REVERIFY_SECRET when using vercel.json.
CRON_SECRET=
# Optional browser-safe, origin-restricted Base read RPC. When omitted, reads
# use the connected injected wallet provider.
NEXT_PUBLIC_BASE_READ_RPC_URL=
